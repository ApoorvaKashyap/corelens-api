# Redis connection
REDIS_HOST=localhost
REDIS_PORT=6379

# AWS credentials
AWS_ACCESS_KEY_ID=xxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxx
AWS_REGION=us-east-1
S3_BASE=bucket-name

# Working Directories
TEMP_PATH=/tmp/
DATA_ROOT=./data
FARM_DATA_ROOT=/absolute/path/to/farm_boundaries

# docker compose variable substitution (host-side paths for bind mounts)
DATA_ROOT_HOST=/absolute/path/to/data
FARM_DATA_ROOT_HOST=/absolute/path/to/farm_boundaries
